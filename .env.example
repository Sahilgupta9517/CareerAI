VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Reusable AI Service API Key (Gemini or OpenAI)
AI_API_KEY=your_key_here
AI_PROVIDER=gemini
AI_MODEL=gemini-3.6-flash
AI_PROVIDER_ORDER=groq,gemini,huggingface,openrouter,openai
AI_TIMEOUT_MS=18000
AI_MAX_RETRIES=1
AI_CACHE_TTL_SECONDS=86400

# Optional provider used when the primary provider is unavailable
AI_FALLBACK_API_KEY=your_fallback_provider_key
AI_FALLBACK_MODEL=gpt-4o-mini

# Optional additional server-side provider keys. Never prefix these with VITE_.
OPENROUTER_API_KEY=your_openrouter_key
OPENROUTER_MODEL=openrouter/free
OPENAI_API_KEY=your_openai_key

# Optional server-side providers. Never prefix these with VITE_.
GROQ_API_KEY=your_groq_key
GROQ_MODEL=llama-3.1-8b-instant
HUGGINGFACE_API_KEY=your_huggingface_token
HUGGINGFACE_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Optional server-side job provider. Leave unset to use CareerAI Demo Data.
JOB_PROVIDER=rest
JOB_PROVIDER_NAME=Configured Job Provider
JOB_PROVIDER_URL=https://your-job-provider.example/jobs
JOB_PROVIDER_API_KEY=your_server_only_job_provider_key
JOB_PROVIDER_TIMEOUT_MS=8000